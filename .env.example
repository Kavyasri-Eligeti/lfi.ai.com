# ---------------------------------------------------------------------------
# lfiai.com - example environment file
#
# Copy to `.env.local` (git-ignored) or set these in the build environment:
#
#     cp .env.example .env.local
#
# PLACEHOLDER VALUES ONLY. Never commit a real endpoint, key or credential to
# this file - it is tracked in git.
#
# Create React App only exposes variables prefixed REACT_APP_, and it inlines
# them into the JavaScript bundle at BUILD time. That has two consequences:
#
#   1. Rebuild after changing one. Restarting the dev server is not enough.
#   2. Anything put here is PUBLIC. It ships in the bundle and can be read by
#      any visitor. SMTP passwords, API keys and mail-provider tokens must
#      live on the server behind the endpoint below - never in this file.
# ---------------------------------------------------------------------------

# Where the contact form POSTs its JSON. Optional.
#
# Unset (the default): the form validates and then opens a prepared message in
# the visitor's email client, addressed to sales@linkfields.com. The UI says so
# and never reports a message as sent.
#
# Set: the form POSTs to this URL and reports the real outcome. A non-2xx
# response is shown as a failure, with the email route offered as a fallback.
#
# The endpoint must be a server you control - a serverless function, an API
# route, or a form service. It is responsible for everything the browser
# cannot be trusted with:
#
#   - re-validating every field (the client's checks are a convenience only)
#   - sanitising values before they reach an email body or a database
#   - rate limiting by IP and by sender address
#   - holding the mail credentials
#   - returning 2xx only when the message has actually been accepted
#
# Request body:
#   { "name", "email", "company", "phone", "interest", "message",
#     "source": "lfiai.com" }
#
REACT_APP_CONTACT_ENDPOINT=https://example.com/api/contact
